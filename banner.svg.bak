<svg width="800" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e293b;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3" />
      <feOffset dx="2" dy="2" result="offsetblur" />
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.5" />
      </feComponentTransfer>
      <feMerge>
        <feMergeNode />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <rect width="100%" height="100%" fill="url(#grad1)" rx="15" />
  
  <!-- Abstract Robotic Circuit Pattern -->
  <path d="M50 50 L100 50 L120 70 L120 120" stroke="#38bdf8" stroke-width="2" fill="none" opacity="0.3" />
  <circle cx="50" cy="50" r="3" fill="#38bdf8" opacity="0.5" />
  <path d="M750 150 L700 150 L680 130 L680 80" stroke="#818cf8" stroke-width="2" fill="none" opacity="0.3" />
  <circle cx="750" cy="150" r="3" fill="#818cf8" opacity="0.5" />

  <!-- Humanoid Robot Diagram Left -->
  <g transform="translate(60, 160) scale(0.6)" stroke="#38bdf8" stroke-width="2" fill="none" opacity="0.6">
    <rect x="30" y="0" width="40" height="35" rx="5" />
    <circle cx="40" cy="15" r="2" fill="#38bdf8" />
    <circle cx="60" cy="15" r="2" fill="#38bdf8" />
    <line x1="50" y1="35" x2="50" y2="45" />
    <rect x="20" y="45" width="60" height="70" rx="5" />
    <circle cx="15" cy="55" r="5" />
    <path d="M10 55 L-5 80 L5 110" />
    <circle cx="85" cy="55" r="5" />
    <path d="M90 55 L105 80 L95 110" />
    <circle cx="35" cy="115" r="5" />
    <path d="M35 120 L30 155 L40 190" />
    <circle cx="65" cy="115" r="5" />
    <path d="M65 120 L70 155 L60 190" />
  </g>

  <!-- Humanoid Robot Diagram Right -->
  <g transform="translate(740, 160) scale(0.6) scale(-1, 1)" stroke="#818cf8" stroke-width="2" fill="none" opacity="0.6">
    <rect x="30" y="0" width="40" height="35" rx="5" />
    <circle cx="40" cy="15" r="2" fill="#818cf8" />
    <circle cx="60" cy="15" r="2" fill="#818cf8" />
    <line x1="50" y1="35" x2="50" y2="45" />
    <rect x="20" y="45" width="60" height="70" rx="5" />
    <circle cx="15" cy="55" r="5" />
    <path d="M10 55 L-5 80 L5 110" />
    <circle cx="85" cy="55" r="5" />
    <path d="M90 55 L105 80 L95 110" />
    <circle cx="35" cy="115" r="5" />
    <path d="M35 120 L30 155 L40 190" />
    <circle cx="65" cy="115" r="5" />
    <path d="M65 120 L70 155 L60 190" />
  </g>
  
  <text x="50%" y="45%" dominant-baseline="middle" text-anchor="middle" font-family="Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="42" font-weight="bold" fill="#f8fafc" filter="url(#shadow)">
    AWESOME WHOLE-BODY CONTROL
  </text>
  <text x="50%" y="85%" dominant-baseline="middle" text-anchor="middle" font-family="Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="18" fill="#94a3b8" letter-spacing="2">
    The Definitive Humanoid Robotics Ecosystem
  </text>

  <!-- Robot Icon Simplified -->
  <g transform="translate(375, 170) scale(0.5)" opacity="0.8">
    <rect x="0" y="0" width="100" height="80" rx="10" fill="none" stroke="#38bdf8" stroke-width="4" />
    <circle cx="30" cy="30" r="8" fill="#38bdf8" />
    <circle cx="70" cy="30" r="8" fill="#38bdf8" />
    <path d="M30 60 Q50 75 70 60" stroke="#38bdf8" stroke-width="4" fill="none" />
  </g>
</svg>
